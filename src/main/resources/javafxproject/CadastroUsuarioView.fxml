<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="437.0" prefWidth="656.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafxproject.controller.CadastroUsuarioController">
    <children>
        <Label layoutX="126.0" layoutY="70.0" prefHeight="28.0" prefWidth="59.0" text="Nome">
            <font>
                <Font size="19.0" />
            </font>
        </Label>
        <Label layoutX="126.0" layoutY="99.0" prefHeight="28.0" prefWidth="52.0" text="Email">
            <font>
                <Font size="19.0" />
            </font>
        </Label>
        <Label layoutX="126.0" layoutY="128.0" prefHeight="28.0" prefWidth="52.0" text="CPF">
            <font>
                <Font size="19.0" />
            </font>
        </Label>
        <TextField fx:id="nomeTextField" layoutX="185.0" layoutY="70.0" prefHeight="28.0" prefWidth="346.0" />
        <TextField fx:id="emailTextField" layoutX="185.0" layoutY="99.0" prefHeight="28.0" prefWidth="346.0" />
        <TextField fx:id="cpfTextField" layoutX="185.0" layoutY="128.0" prefHeight="28.0" prefWidth="346.0" promptText="Apenas números" />
        <Button fx:id="cadastrarButton" layoutX="147.0" layoutY="356.0" mnemonicParsing="false" onAction="#cadastrar" prefHeight="34.0" prefWidth="103.0" style="-fx-border-radius: 100; -fx-background-radius: 100;" text="Cadastrar">
            <font>
                <Font size="17.0" />
            </font>
        </Button>
        <Button fx:id="voltarButton" layoutX="394.0" layoutY="356.0" mnemonicParsing="false" onAction="#voltarMenu" prefHeight="34.0" prefWidth="103.0" style="-fx-border-radius: 100; -fx-background-radius: 100;" text="Voltar">
            <font>
                <Font size="17.0" />
            </font>
        </Button>
      <RadioButton fx:id="alunoRadioButton" layoutX="218.0" layoutY="228.0" mnemonicParsing="false" onAction="#tipoUsuario" prefHeight="28.0" prefWidth="93.0" text="Aluno">
         <font>
            <Font size="16.0" />
         </font>
         <toggleGroup>
            <ToggleGroup fx:id="tipoUsuarioToggleGroup" />
         </toggleGroup>
      </RadioButton>
      <RadioButton fx:id="funcionarioRadioButton" layoutX="349.0" layoutY="228.0" mnemonicParsing="false" onAction="#tipoUsuario" prefHeight="28.0" prefWidth="129.0" text="Funcionário" toggleGroup="$tipoUsuarioToggleGroup">
         <font>
            <Font size="16.0" />
         </font>
      </RadioButton>
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="137.0" layoutY="191.0" prefHeight="28.0" prefWidth="383.0" text="Que tipo de usuário você irá cadastrar?">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="cursoLabel" layoutX="147.0" layoutY="276.0" prefHeight="28.0" prefWidth="59.0" text="Curso">
         <font>
            <Font size="19.0" />
         </font>
      </Label>
      <TextField fx:id="cursoTextField" layoutX="206.0" layoutY="276.0" prefHeight="28.0" prefWidth="346.0" />
      <Label fx:id="turmaLabel" layoutX="147.0" layoutY="310.0" prefHeight="28.0" prefWidth="59.0" text="Turma">
         <font>
            <Font size="19.0" />
         </font>
      </Label>
      <TextField fx:id="turmaTextField" layoutX="206.0" layoutY="310.0" prefHeight="28.0" prefWidth="346.0" />
      <Label fx:id="cargoLabel" layoutX="147.0" layoutY="290.0" prefHeight="28.0" prefWidth="59.0" text="Cargo">
         <font>
            <Font size="19.0" />
         </font>
      </Label>
      <TextField fx:id="cargoTextField" layoutX="206.0" layoutY="290.0" prefHeight="28.0" prefWidth="346.0" />
    </children>
</AnchorPane>
