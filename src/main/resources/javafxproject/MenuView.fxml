<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafxproject.controller.MenuController">
   <children>
      <Button fx:id="buttonCadastrarUsuario" layoutX="450.0" layoutY="45.0" mnemonicParsing="false" onAction="#exibirCadastrarUsuario" prefHeight="60.0" prefWidth="300.0" style="-fx-border-radius: 100; -fx-background-radius: 100;" text="Cadastrar Usuário">
         <font>
            <Font size="28.0" />
         </font>
      </Button>
      <Button fx:id="buttonCadastrarLivro" layoutX="450.0" layoutY="142.0" mnemonicParsing="false" onAction="#exibirCadastrarLivro" prefHeight="60.0" prefWidth="300.0" style="-fx-border-radius: 100; -fx-background-radius: 100;" text="Cadastrar Livro">
         <font>
            <Font size="28.0" />
         </font>
      </Button>
      <Button layoutX="450.0" layoutY="429.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="300.0" style="-fx-border-radius: 100; -fx-background-radius: 100;" text="Empréstimo">
         <font>
            <Font size="28.0" />
         </font>
      </Button>
      <Button layoutX="450.0" layoutY="238.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="300.0" style="-fx-border-radius: 100; -fx-background-radius: 100;" text="Listar Usuários">
         <font>
            <Font size="28.0" />
         </font>
      </Button>
      <Button layoutX="450.0" layoutY="331.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="300.0" style="-fx-border-radius: 100; -fx-background-radius: 100;" text="Listar Livros">
         <font>
            <Font size="28.0" />
         </font>
      </Button>
      <Button layoutX="450.0" layoutY="524.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="300.0" style="-fx-border-radius: 100; -fx-background-radius: 100;" text="Devolver Livro">
         <font>
            <Font size="28.0" />
         </font>
      </Button>
      <Button fx:id="buttonSair" layoutX="450.0" layoutY="612.0" mnemonicParsing="false" onAction="#sair" prefHeight="60.0" prefWidth="300.0" style="-fx-border-radius: 100; -fx-background-radius: 100; -fx-border-color: black;" text="Sair">
         <font>
            <Font size="28.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button fx:id="exibirTelaLogin" layoutX="85.0" layoutY="208.0" mnemonicParsing="false" onAction="#exibirTelaLogin" prefHeight="60.0" prefWidth="300.0" style="-fx-border-radius: 100; -fx-background-radius: 100;" text="Login">
         <font>
            <Font size="28.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
